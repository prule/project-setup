#!/usr/bin/env bash

set -e

function print_help {
    echo "Usage: ./run [command]"
    echo ""
    echo "Commands:"
    echo "  setup    - Installs mkdocs-material, pinned in requirements.txt, into .venv"
    echo "  serve    - Starts the local live-reloading development server"
    echo "  build    - Builds the static site for production into the site/ directory"
    echo "  help     - Shows this help message"
}

# The pinned .venv copy from ./run setup, else an mkdocs already on PATH.
function mkdocs_bin {
    if [ -x .venv/bin/mkdocs ]; then echo .venv/bin/mkdocs; else echo mkdocs; fi
}

case "$1" in
    setup)
        echo "Installing MkDocs dependencies into .venv..."
        # A venv, not a global pip install: Ubuntu's python3 refuses that (PEP 668).
        python3 -m venv .venv
        .venv/bin/pip install --quiet -r requirements.txt
        ;;
    serve)
        echo "Starting MkDocs local server..."
        "$(mkdocs_bin)" serve
        ;;
    build)
        echo "Building static site..."
        "$(mkdocs_bin)" build
        ;;
    help|*)
        print_help
        ;;
esac
