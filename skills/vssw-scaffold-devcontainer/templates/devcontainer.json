{
  "name": "{{PROJECT_NAME}}",

  // JS toolchain (fnm + Node, standalone pnpm, OpenSpec CLI) is built from the
  // Dockerfile — NOT corepack. See docs/DevContainers.md.
  "build": { "dockerfile": "Dockerfile" },

  // Binaries layered on as official Dev Container Features:
  //   - github-cli, claude-code : always.
  //   - java : ONLY if the base image is NOT already a java image.
  //   - docker-in-docker : ONLY if the app needs nested Docker (e.g. Supabase).
  "features": {
    "ghcr.io/devcontainers/features/github-cli:1": {},
    "ghcr.io/anthropics/devcontainer-features/claude-code:1": {}
    // , "ghcr.io/devcontainers/features/docker-in-docker:2": { "moby": true }
  },

  // Predictable identity. --hostname => `vscode@{{PROJECT_NAME}}` prompt.
  // Add "--privileged" as a third arg ONLY when using docker-in-docker.
  // If a rebuild ever 409s on the name: docker rm -f {{PROJECT_NAME}}-dev
  "runArgs": ["--name", "{{PROJECT_NAME}}-dev", "--hostname", "{{PROJECT_NAME}}"],

  "forwardPorts": [{{PORTS}}],

  // Volumes — see docs/DevContainers.md "Shared repositories".
  //   SHARED across every dev container (one download / one login per machine):
  //     - devcontainer-cache -> /cache : holds the pnpm store (/cache/pnpm-store)
  //       AND the Gradle cache (/cache/gradle). Name + path are the sharing
  //       mechanism — never rename per project.
  //     - devcontainer-claude -> ~/.claude, devcontainer-gh -> ~/.config/gh :
  //       the `claude` and `gh` logins, so you log in ONCE per machine and the
  //       login survives every rebuild. Same rule — never rename per project,
  //       and keep the CLAUDE_CONFIG_DIR / GH_CONFIG_DIR vars below, without
  //       which these volumes persist everything EXCEPT the credentials.
  //     - devcontainer-playwright -> ~/.cache/ms-playwright : the browsers
  //       (~1GB a set, once per machine instead of once per project). Safe ONLY
  //       with PLAYWRIGHT_SKIP_BROWSER_GC below — see the note there.
  //   PER-PROJECT (isolated, disposable):
  //     - node_modules  : keeps host native binaries out of the Linux container.
  //     - <name>-dind   : nested Docker images, ONLY with docker-in-docker.
  // NEVER mount a volume at ~/.local/share/pnpm (PNPM_HOME) — it shadows the
  // baked-in standalone pnpm.
  "mounts": [
    "source={{PROJECT_NAME}}-node-modules,target=${containerWorkspaceFolder}/node_modules,type=volume",
    "source=devcontainer-cache,target=/cache,type=volume",
    "source=devcontainer-playwright,target=/home/vscode/.cache/ms-playwright,type=volume",
    "source=devcontainer-claude,target=/home/vscode/.claude,type=volume",
    "source=devcontainer-gh,target=/home/vscode/.config/gh,type=volume"
  ],

  // containerEnv (NOT remoteEnv) so every process inherits it. Add
  // GRADLE_USER_HOME only for Kotlin/Gradle projects (shared Gradle cache).
  //
  // CLAUDE_CONFIG_DIR / GH_CONFIG_DIR are NOT optional — they are what make the
  // login volumes above actually hold the credentials:
  //   - Claude Code splits its state: the tokens go to ~/.claude/.credentials.json
  //     (on the volume) but the ACCOUNT lives in ~/.claude.json, a file in $HOME
  //     that no volume covers, so every rebuild forced a fresh login.
  //     CLAUDE_CONFIG_DIR relocates it to ~/.claude/.claude.json.
  //   - gh resolves its config dir from $XDG_CONFIG_HOME/gh, and the JetBrains
  //     backend re-points XDG_CONFIG_HOME at /.jbdevcontainer/config (the same
  //     gotcha that bites pnpm's store-dir) — so `gh auth login` wrote to a
  //     throwaway dir, never the mounted ~/.config/gh. GH_CONFIG_DIR is
  //     absolute and outranks XDG.
  //
  // PLAYWRIGHT_SKIP_BROWSER_GC is what makes the SHARED browser volume safe.
  // Playwright tracks who uses each browser via `.links/<sha1>` files holding an
  // ABSOLUTE path to that project's playwright-core — which lives on the
  // per-project node_modules volume, invisible from any other container. So on
  // `playwright install`, project B sees project A's link pointing at a missing
  // dir, calls it broken, and GCs every browser nothing else references
  // (registry's _validateInstallationCache -> _deleteStaleBrowsers /
  // _deleteBrokenInstallations). This var skips that validation. Browsers are
  // revision-keyed (chromium-1234) so mixed Playwright versions coexist, and the
  // installer holds a lockfile so concurrent installs serialise. Trade-off:
  // nothing reclaims superseded revisions — sweep the volume now and then.
  "containerEnv": {
    "PLAYWRIGHT_BROWSERS_PATH": "/home/vscode/.cache/ms-playwright",
    "PLAYWRIGHT_SKIP_BROWSER_GC": "1",
    "OPENSPEC_TELEMETRY": "0",
    "CLAUDE_CONFIG_DIR": "/home/vscode/.claude",
    "GH_CONFIG_DIR": "/home/vscode/.config/gh"
    // , "GRADLE_USER_HOME": "/cache/gradle"
  },

  "postCreateCommand": "bash .devcontainer/post-create.sh",
  "remoteUser": "vscode",

  // VS Code reads `vscode`; JetBrains reads `jetbrains`. Both open the SAME
  // container. Backend: "WebStorm" for frontend, "IntelliJ" for Kotlin/Gradle.
  "customizations": {
    "vscode": {
      "extensions": ["esbenp.prettier-vscode", "ms-playwright.playwright"],
      "settings": { "terminal.integrated.defaultProfile.linux": "zsh" }
    },
    "jetbrains": { "backend": "WebStorm" }
  }
}
